# Database
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/mlegitymacja24?schema=public"

# JWT
JWT_SECRET="change-this-in-production-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-too-different-from-jwt-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# QR / verification signing
QR_SIGNING_SECRET="change-this-signing-secret-for-qr-tokens"
QR_TOKEN_TTL_SECONDS=45

# Server
PORT=7000
NODE_ENV=development

# Frontend URL
FRONTEND_URL="https://mlegitymacja24.pl"

# Email (SMTP - to be configured with real provider)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@mlegitymacja24.pl"

# SMS provider (to be configured later)
SMS_API_KEY=""
SMS_API_URL=""

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# 2FA
TWO_FACTOR_ISSUER="mLegitymacja24"

# Płatności - Stripe (opcjonalnie; bez klucza dostępny jest tylko przelew)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Dane do przelewu tradycyjnego (opcjonalnie)
BANK_RECIPIENT=
BANK_IBAN=
BANK_NAME=
# Okres próbny po zatwierdzeniu firmy (dni)
TRIAL_DAYS=14
